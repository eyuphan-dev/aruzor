# Aruzor yapılandırması.
#
# Bu dosyayı .env olarak kopyalayın ve doldurun. install.sh çalıştırırsanız
# .env sizin için üretilir; bu örnek, hangi ayarların var olduğunu görmek ve
# elle kurulum yapmak içindir.
#
#   cp .env.example .env
#
# .env dosyası gizlidir ve .gitignore içindedir — depoya eklemeyin.

# Dışarı açılan tek port. Backend ve Prometheus konteyner ağında kalır.
ARUZOR_PORT=3000

# Oturum imza anahtarı. Değişirse herkes çıkış yapmış olur, o yüzden bir kez
# üretip sabit bırakın:
#   openssl rand -hex 32
ARUZOR_JWT_SECRET=

# Yönetici hesabı. İkisini de boş bırakmak tercih edilir: o zaman hesap
# tarayıcıdaki kurulum ekranından açılır ve şifre hiçbir dosyaya yazılmaz.
# Etkileşimsiz kurulum yapıyorsanız doldurun.
ARUZOR_ADMIN_EMAIL=
ARUZOR_ADMIN_PASSWORD=

# Günlük özetin saati bu zaman dilimine göre hesaplanır.
ARUZOR_TIMEZONE=Europe/Istanbul

# Telegram bildirimleri (isteğe bağlı, boşken kapalıdır).
# Bot token'ı @BotFather'dan, sohbet kimliği getUpdates çıktısından alınır.
ARUZOR_TELEGRAM_BOT_TOKEN=
ARUZOR_TELEGRAM_CHAT_ID=

# Prometheus adresi. Boş bırakılırsa otomatik bulunur; yalnızca yığının
# dışında, başka bir makinedeki Prometheus'a bağlanacaksanız doldurun.
ARUZOR_PROMETHEUS_URL=

# Tarayıcı bildirimleri (push) hiç yapılandırma istemez — anahtarlar ilk
# açılışta kendiliğinden üretilip veritabanında saklanır. Bu satır yalnızca
# bazı push servislerinin (Mozilla gibi) istediği iletişim adresi içindir,
# boş bırakılırsa varsayılan kullanılır.
ARUZOR_VAPID_SUBJECT=

# Webhook (Slack/Discord/kendi entegrasyonunuz) ve durum sayfası gibi ayarlar
# .env değil, uygulama içindeki Ayarlar sayfasından yönetilir.
